# Copiá este archivo como .env solo si necesitás cambiar los valores.

PORT=3000

# OJO: dentro del contenedor de postgres la base escucha en 5432, pero desde
# esta máquina entramos por 5434 porque ya hay otros postgres locales.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tandildb

# Solo para desarrollo: TypeORM crea las tablas a partir de las entidades.
# En producción tiene que ser false y se usan migraciones.
DB_SYNC=true